# ---------------------------------------------------------------------------
# Voter ID Verification Prototype - environment configuration
# Copy this file to `.env` and adjust values as needed. All values have
# sensible defaults, so the application also runs without a `.env` file.
# ---------------------------------------------------------------------------

APP_NAME=Voter ID Verification Prototype
ENVIRONMENT=development
DEBUG=false

# SQLite database location. Leave commented to use the default
# (<project>/data/voter.db). When set, a relative path is resolved against the
# process working directory; an absolute path is used as-is.
# DATABASE_URL=sqlite:///C:/absolute/path/to/voter.db

# Runtime artifact directories (relative paths are resolved against project root).
UPLOAD_DIR=./data/uploads
MODEL_DIR=./data/models

# Session and upload limits
SESSION_TTL_SECONDS=1800
MAX_UPLOAD_MB=15

# CORS origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# OCR confidence below which a field is considered unreadable (0..1)
OCR_MIN_CONFIDENCE=0.55

# Face matching thresholds (cosine similarity, 0..1). Score >= MATCH => MATCH,
# score < REVIEW => MISMATCH, otherwise INCONCLUSIVE.
FACE_SIMILARITY_MATCH=0.45
FACE_SIMILARITY_REVIEW=0.30

# Name field similarity threshold for database cross-verification (0..1)
NAME_SIMILARITY_THRESHOLD=0.85

# Demonstration mode: never claims authoritative issuer verification.
DEMO_MODE=true
